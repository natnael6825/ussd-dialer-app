{
  "expo": {
    "name": "USSD Flow API",
    "slug": "ussd-flow",
    "version": "1.1.3",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "icon": "./assets/icon-api.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.fikre.ussdflow",
      "versionCode": 7,
      "allowBackup": false,
      "permissions": [
        "android.permission.CALL_PHONE",
        "android.permission.READ_PHONE_STATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#071857",
        "foregroundImage": "./assets/icon-api.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "networkInspector": false,
            "usesCleartextTraffic": false,
            "extraProguardRules": "-keep,allowoptimization class com.fikre.ussddialer.UssdAutomationService { public <init>(); }\n-renamesourcefileattribute SourceFile"
          }
        }
      ],
      "expo-font",
      "./plugins/with-android-release-hardening"
    ]
  }
}
