# The relay listens only on this computer unless you deliberately change HOST.
HOST=127.0.0.1
PORT=8787

# Generate independent secrets, for example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CONTROL_API_KEY=
DEVICE_ENROLLMENT_KEY=
DEVICE_TOKEN_SECRET=

# A phone is considered offline if it has not polled or sent a heartbeat recently.
DEVICE_ONLINE_SECONDS=60
DEVICE_TOKEN_TTL_SECONDS=2592000
JOB_DEFAULT_TTL_SECONDS=120
JOB_ACK_TIMEOUT_SECONDS=15
MAX_BODY_BYTES=65536

# Waiting runs are capped separately from all retained run records. The phone
# queue UI supports at most 256 items, so this value cannot exceed 256.
MAX_QUEUED_JOBS_PER_DEVICE=200
MAX_JOBS_PER_DEVICE=1000

# Direct non-loopback HTTP exposes API keys and financial instructions. Keep false.
# Put this server behind HTTPS, or set true only for a temporary trusted-LAN test.
ALLOW_INSECURE_REMOTE_HTTP=false
